# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{lisp,asd,el}]
max_line_length = 80

[{README,README.md,test/data/**}]
charset = unset
end_of_line = unset
insert_final_newline = unset
indent_style = unset
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
